{
  // Run with: markdownlint-cli2
  "globs": ["**/*.md"],
  "ignores": [
    "target",
    "book",
    ".direnv",
    // Generated by release-plz from commit messages; not hand-written prose.
    "CHANGELOG.md",
    // Schemas are markdown-shaped, but they are a DSL rather than prose: their
    // indentation is semantic (nesting), `<? … ?>` reads as inline HTML, and
    // headings intentionally sit next to their children. Prose style rules do
    // not apply to them.
    "**/*.schema.md"
  ],
  // NOTE: examples/five_verbs.md is deliberately *not* ignored. It is the exact
  // output of `render`, held to byte equality by `cargo run --example
  // five_verbs`, so linting it here is what proves marklens generates
  // well-formed markdown. If it starts failing, fix the renderer, not the file.
  "config": {
    // Prose wraps at 80. Tables and code blocks are data, not prose — a schema
    // example or a wide table row must not be broken to satisfy a ruler.
    "MD013": { "line_length": 80, "tables": false, "code_blocks": false },
    // This project documents whitespace-significant markers, so code spans like
    // `- `, `1. `, `> ` and `- [ ] ` carry a deliberate trailing space. Per
    // CommonMark, a span is only stripped when it has a space at *both* ends,
    // so these render exactly as written.
    "MD038": false
  }
}
